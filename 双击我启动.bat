@echo off
title 实验二 - 前后端分离（一键启动）
cd /d "%~dp0"

echo ============================================================
echo   实验二 · 前后端分离与 RESTful API
echo ------------------------------------------------------------
echo   接下来会打开【两个】黑窗口：
echo     窗口 1 = 后端（Spring Boot，端口 8081）
echo     窗口 2 = 前端（静态服务器，端口 5173）
echo   等 30 秒左右，浏览器会自动打开页面
echo   用完把这两个窗口关掉就停止服务了
echo ============================================================
echo.

powershell -NoProfile -ExecutionPolicy Bypass -File "%~dp0启动全部.ps1" %*

echo.
echo 启动器已退出。按任意键关闭本窗口。
pause >nul
